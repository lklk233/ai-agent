# ============================================================
# 环境变量配置模板（可提交到仓库；复制为 .env 后按需修改）
# 规则：已存在的系统环境变量优先于 .env；修改后重启服务生效。
# ============================================================

# ---- 本地部署：Ollama 服务地址（默认本机 11434）----
OLLAMA_HOST=127.0.0.1:11434

# ---- 默认 LLM 模型（config.json 的 llm_model 默认值）----
# LLM_MODEL=deepseek-r1:8b

# ---- Windows 中文控制台输出编码（避免日志乱码）----
PYTHONIOENCODING=utf-8

# ---- 服务监听（默认仅本机）----
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
